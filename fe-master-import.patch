@@ -0,0 +1,209 @@
+import { useState } from 'react';
+import { Plus, Upload } from 'lucide-react';
+import SearchInput from '../common/SearchInput';
+import Pagination from '../common/Pagination';
+import ErrorState from '../common/ErrorState';
+import Modal from '../common/Modal';
+import ImportModal from './ImportModal';
+import useApi from '../../hooks/useApi';
+import useDebounce from '../../hooks/useDebounce';
+import { getErrorMessage } from '../../services/api';
+import { getClassRooms, createClassRoom, updateClassRoom, deleteClassRoom } from '../../services/classRoomService';
+import { importClassRooms } from '../../services/importService';
+import { IMPORT_TEMPLATES } from '../../data/importTemplates';
+
+const PAGE_SIZE = 10;
+const inputCls =
+  'w-full px-3 py-2 border border-gray-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500';
+
+const emptyForm = { code: '', name: '', grade: '', academicYear: '', description: '', isActive: true };
+
+function Field({ label, children }) {
+  return (
+    <label className="block">
+      <span className="block text-xs font-medium text-gray-600 mb-1">{label}</span>
+      {children}
+    </label>
+  );
+}
+
+function ClassRoomForm({ initial, onClose, onSaved }) {
+  const editing = Boolean(initial?.id);
+  const [form, setForm] = useState(initial ?? emptyForm);
+  const [saving, setSaving] = useState(false);
+  const [error, setError] = useState(null);
+  const set = (key) => (e) => setForm((f) => ({ ...f, [key]: e.target.value }));
+
+  async function submit(e) {
+    e.preventDefault();
+    setSaving(true);
+    setError(null);
+    const payload = {
+      code: form.code.trim(),
+      name: form.name.trim(),
+      grade: Number(form.grade),
+      academicYear: form.academicYear.trim(),
+      description: form.description?.trim() || null,
+    };
+    try {
+      if (editing) await updateClassRoom(initial.id, { ...payload, isActive: form.isActive });
+      else await createClassRoom(payload);
+      onSaved();
+    } catch (err) {
+      setError(getErrorMessage(err));
+    } finally {
+      setSaving(false);
+    }
+  }
+
+  return (
+    <Modal
+      title={editing ? 'Ubah Kelas' : 'Tambah Kelas'}
+      onClose={onClose}
+      footer={
+        <>
+          <button type="button" onClick={onClose} className="px-4 py-2 text-sm border border-gray-200 rounded-lg hover:bg-gray-50">Batal</button>
+          <button form="classroom-form" disabled={saving} className="px-4 py-2 text-sm bg-blue-600 text-white rounded-lg hover:bg-blue-700 disabled:opacity-60">
+            {saving ? 'Menyimpan...' : 'Simpan'}
+          </button>
+        </>
+      }
+    >
+      <form id="classroom-form" onSubmit={submit} className="grid grid-cols-1 sm:grid-cols-2 gap-4">
+        {error && <div className="sm:col-span-2"><ErrorState message={error} /></div>}
+        <Field label="Kode"><input required className={inputCls} value={form.code} onChange={set('code')} placeholder="X-IPA-1" /></Field>
+        <Field label="Nama"><input required className={inputCls} value={form.name} onChange={set('name')} placeholder="X IPA 1" /></Field>
+        <Field label="Tingkat"><input required type="number" min={1} className={inputCls} value={form.grade} onChange={set('grade')} placeholder="10" /></Field>
+        <Field label="Tahun Ajaran"><input required className={inputCls} value={form.academicYear} onChange={set('academicYear')} placeholder="2026/2027" /></Field>
+        {editing && (
+          <Field label="Status">
+            <select className={inputCls} value={String(form.isActive)} onChange={(e) => setForm((f) => ({ ...f, isActive: e.target.value === 'true' }))}>
+              <option value="true">Aktif</option>
+              <option value="false">Nonaktif</option>
+            </select>
+          </Field>
+        )}
+        <div className="sm:col-span-2">
+          <Field label="Keterangan"><textarea rows={2} className={inputCls} value={form.description ?? ''} onChange={set('description')} /></Field>
+        </div>
+      </form>
+    </Modal>
+  );
+}
+
+export default function ClassRoomsTab() {
+  const [search, setSearch] = useState('');
+  const [page, setPage] = useState(1);
+  const [editor, setEditor] = useState(null);
+  const [deleting, setDeleting] = useState(null);
+  const [importing, setImporting] = useState(false);
+  const [actionError, setActionError] = useState(null);
+  const keyword = useDebounce(search.trim());
+
+  const list = useApi(
+    (signal) => getClassRooms({ search: keyword || undefined, pageNumber: page, pageSize: PAGE_SIZE }, signal),
+    [keyword, page]
+  );
+  const items = list.data?.items ?? [];
+
+  async function confirmDelete() {
+    try {
+      await deleteClassRoom(deleting.id);
+      setActionError(null);
+      list.reload();
+    } catch (err) {
+      setActionError(getErrorMessage(err));
+    } finally {
+      setDeleting(null);
+    }
+  }
+
+  return (
+    <div>
+      <div className="flex flex-wrap items-center justify-between gap-3 mb-4">
+        <SearchInput value={search} onChange={(v) => { setSearch(v); setPage(1); }} placeholder="Cari kode atau nama kelas..." />
+        <div className="flex items-center gap-3">
+          <button onClick={() => setImporting(true)} className="flex items-center gap-2 px-4 py-2 text-sm border border-gray-200 bg-white text-gray-700 rounded-lg hover:bg-gray-50">
+            <Upload size={16} /> Impor Excel
+          </button>
+          <button onClick={() => setEditor({ initial: null })} className="flex items-center gap-2 px-4 py-2 bg-blue-600 text-white text-sm rounded-lg hover:bg-blue-700">
+            <Plus size={16} /> Tambah Kelas
+          </button>
+        </div>
+      </div>
+
+      <div className="bg-white rounded-xl p-6 shadow-sm border border-gray-100">
+        {(list.error || actionError) && <div className="mb-4"><ErrorState message={list.error || actionError} onRetry={list.reload} /></div>}
+
+        <div className={`overflow-x-auto ${list.loading ? 'opacity-60' : ''}`}>
+          <table className="w-full">
+            <thead>
+              <tr className="text-left text-xs text-gray-500 uppercase tracking-wider border-b border-gray-200">
+                <th className="pb-3 font-semibold">KODE</th>
+                <th className="pb-3 font-semibold">NAMA</th>
+                <th className="pb-3 font-semibold">TINGKAT</th>
+                <th className="pb-3 font-semibold">TAHUN AJARAN</th>
+                <th className="pb-3 font-semibold">STATUS</th>
+                <th className="pb-3 font-semibold text-right">AKSI</th>
+              </tr>
+            </thead>
+            <tbody>
+              {items.length === 0 && !list.loading && (
+                <tr><td colSpan={6} className="py-8 text-center text-sm text-gray-400">Belum ada kelas.</td></tr>
+              )}
+              {items.map((c) => (
+                <tr key={c.id} className="border-b border-gray-100 last:border-0 hover:bg-gray-50">
+                  <td className="py-3 text-sm text-gray-600">{c.code}</td>
+                  <td className="py-3 text-sm font-medium text-gray-800">{c.name}</td>
+                  <td className="py-3 text-sm text-gray-600">{c.grade}</td>
+                  <td className="py-3 text-sm text-gray-600">{c.academicYear}</td>
+                  <td className="py-3">
+                    <span className={`px-2.5 py-1 rounded-full text-xs font-medium ${c.isActive ? 'bg-green-100 text-green-700' : 'bg-gray-100 text-gray-600'}`}>
+                      {c.isActive ? 'Aktif' : 'Nonaktif'}
+                    </span>
+                  </td>
+                  <td className="py-3">
+                    <div className="flex items-center justify-end gap-3 text-xs">
+                      <button onClick={() => setEditor({ initial: { ...c, description: c.description ?? '' } })} className="text-green-600 hover:text-green-800 font-medium">Edit</button>
+                      <button onClick={() => setDeleting(c)} className="text-red-600 hover:text-red-800 font-medium">Hapus</button>
+                    </div>
+                  </td>
+                </tr>
+              ))}
+            </tbody>
+          </table>
+        </div>
+
+        <Pagination page={page} pageSize={PAGE_SIZE} total={list.data?.totalRecords ?? 0} onChange={setPage} unit="kelas" />
+      </div>
+
+      {editor && (
+        <ClassRoomForm initial={editor.initial} onClose={() => setEditor(null)} onSaved={() => { setEditor(null); setActionError(null); list.reload(); }} />
+      )}
+
+      {importing && (
+        <ImportModal
+          template={IMPORT_TEMPLATES.classRooms}
+          onImport={(file) => importClassRooms(file)}
+          onClose={() => setImporting(false)}
+          onDone={list.reload}
+        />
+      )}
+
+      {deleting && (
+        <Modal
+          title="Hapus Kelas"
+          onClose={() => setDeleting(null)}
+          footer={
+            <>
+              <button onClick={() => setDeleting(null)} className="px-4 py-2 text-sm border border-gray-200 rounded-lg hover:bg-gray-50">Batal</button>
+              <button onClick={confirmDelete} className="px-4 py-2 text-sm bg-red-600 text-white rounded-lg hover:bg-red-700">Hapus</button>
+            </>
+          }
+        >
+          <p className="text-sm text-gray-600">Hapus kelas <b>{deleting.name}</b> ({deleting.code})?</p>
+        </Modal>
+      )}
+    </div>
+  );
+}
