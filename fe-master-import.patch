+      { header: 'Address', hint: 'Opsional.' },
+      { header: 'PhotoUrl', hint: 'Opsional.' },
+      { header: 'ClassRoomCode', required: true, hint: 'Kode kelas pada tahun ajaran yang dipilih.' },
+      { header: 'GuardianPhone', required: true, hint: 'Harus sama dengan nomor telepon wali yang sudah terdaftar.' },
+      { header: 'Status', required: true, hint: 'Aktif atau Tidak Aktif.' },
+      { header: 'EnrollmentDate', required: true, hint: 'Format yyyy-MM-dd, mis. 2026-07-13.' },
+    ],
+  },
+};
