--- /dev/null
+++ b/src/services/importService.js
@@ -0,0 +1,40 @@
+import api, { getErrorMessage, unwrap } from './api';
+
+function upload(url, file, params) {
+  const form = new FormData();
+  form.append('file', file);
+  // Content-Type multipart (beserta boundary) diatur otomatis oleh browser.
+  return api.post(url, form, { params, timeout: 120000, headers: { 'Content-Type': undefined } }).then(unwrap);
+}
+
+export const importClassRooms = (file) => upload('/master/classrooms/import', file);
+
+export const importGuardians = (file) => upload('/master/guardians/import', file);
+
+export const importStudents = (file, academicYear) =>
+  upload('/master/students/import', file, { academicYear });
+
+/**
+ * Ubah error impor menjadi { message, rows: string[] }.
+ * BE mengirim detail baris gagal dalam beberapa bentuk:
+ *  - ApiResponse dengan `errors` (["Baris 3: ..."]),
+ *  - objek hasil mentah dengan `results` (impor siswa),
+ *  - teks biasa atau hanya `message`.
+ */
+export function parseImportError(error) {
+  const body = error?.response?.data;
+  const failedFrom = (results) =>
+    results.filter((r) => !r.success).map((r) => `Baris ${r.rowNumber}: ${r.message}`);
+
+  if (Array.isArray(body?.results)) {
+    return { message: 'Impor gagal. Tidak ada data yang disimpan.', rows: failedFrom(body.results) };
+  }
+  if (Array.isArray(body?.data?.results)) {
+    return { message: body.message || 'Impor gagal.', rows: failedFrom(body.data.results) };
+  }
+  if (Array.isArray(body?.errors) && body.errors.length > 0) {
+    return { message: body.message || 'Impor gagal.', rows: body.errors };
+  }
+  if (typeof body === 'string' && body) return { message: body, rows: [] };
+  return { message: getErrorMessage(error), rows: [] };
+}
