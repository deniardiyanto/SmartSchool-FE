+++ b/src/components/master/ImportModal.jsx
@@ -0,0 +1,163 @@
+import { useRef, useState } from 'react';
+import { Download, Upload } from 'lucide-react';
+import Modal from '../common/Modal';
+import { buildXlsx, downloadBlob } from '../../utils/xlsx';
+import { parseImportError } from '../../services/importService';
+
+const inputCls =
+  'w-full px-3 py-2 border border-gray-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500';
+
+/**
+ * @param template     entri dari IMPORT_TEMPLATES
+ * @param onImport     (file, academicYear) => Promise<{ successRows, totalRows }>
+ * @param academicYears saran tahun ajaran (untuk impor siswa)
+ * @param onDone       dipanggil setelah impor berhasil, saat modal ditutup
+ */
+export default function ImportModal({ template, onImport, academicYears = [], onClose, onDone }) {
+  const fileRef = useRef(null);
+  const [file, setFile] = useState(null);
+  const [academicYear, setAcademicYear] = useState(academicYears[0] ?? '');
+  const [busy, setBusy] = useState(false);
+  const [error, setError] = useState(null); // { message, rows }
+  const [result, setResult] = useState(null);
+
+  function downloadTemplate() {
+    const blob = buildXlsx({
+      sheetName: template.sheetName,
+      columns: template.columns.map((c) => ({ header: c.header, width: 20 })),
+      rows: [],
+    });
+    downloadBlob(template.filename, blob);
+  }
+
+  async function submit() {
+    setBusy(true);
+    setError(null);
+    try {
+      const data = await onImport(file, academicYear.trim());
+      setResult(data);
+    } catch (err) {
+      setError(parseImportError(err));
+    } finally {
+      setBusy(false);
+    }
+  }
+
+  const canSubmit = file && (!template.needsAcademicYear || academicYear.trim()) && !busy;
+
+  function close() {
+    if (result) onDone?.();
+    onClose();
+  }
+
+  return (
+    <Modal
+      title={template.title}
+      onClose={close}
+      footer={
+        result ? (
+          <button onClick={close} className="px-4 py-2 text-sm bg-blue-600 text-white rounded-lg hover:bg-blue-700">
+            Selesai
+          </button>
+        ) : (
+          <>
+            <button onClick={close} className="px-4 py-2 text-sm border border-gray-200 rounded-lg hover:bg-gray-50">
+              Batal
+            </button>
+            <button
+              onClick={submit}
+              disabled={!canSubmit}
+              className="flex items-center gap-2 px-4 py-2 text-sm bg-blue-600 text-white rounded-lg hover:bg-blue-700 disabled:opacity-50"
+            >
+              <Upload size={16} /> {busy ? 'Mengimpor...' : 'Impor'}
+            </button>
+          </>
+        )
+      }
+    >
+      {result ? (
+        <div className="text-sm text-green-700 bg-green-50 border border-green-100 rounded-lg px-4 py-3">
+          Impor berhasil: {result.successRows} dari {result.totalRows} baris disimpan.
+        </div>
+      ) : (
+        <div className="space-y-5">
+          <div>
+            <div className="flex flex-wrap items-center justify-between gap-2 mb-2">
+              <p className="text-sm font-medium text-gray-800">Format file (.xlsx)</p>
+              <button onClick={downloadTemplate} className="flex items-center gap-1 text-sm text-blue-600 hover:underline">
+                <Download size={14} /> Unduh template
+              </button>
+            </div>
+            <p className="text-xs text-gray-500 mb-2">
+              Baris pertama adalah header dan dilewati. Urutan kolom harus sama seperti di bawah. Jika ada satu baris yang
+              salah, tidak ada data yang disimpan.
+            </p>
+            <div className="border border-gray-100 rounded-lg overflow-hidden">
+              <table className="w-full text-xs">
+                <tbody>
+                  {template.columns.map((c, i) => (
+                    <tr key={c.header} className="border-b border-gray-100 last:border-0">
+                      <td className="px-3 py-2 text-gray-400 w-8">{i + 1}</td>
+                      <td className="px-3 py-2 font-medium text-gray-800 whitespace-nowrap">
+                        {c.header}
+                        {c.required && <span className="text-red-500"> *</span>}
+                      </td>
+                      <td className="px-3 py-2 text-gray-500">{c.hint}</td>
+                    </tr>
+                  ))}
+                </tbody>
+              </table>
+            </div>
+          </div>
+
+          {template.needsAcademicYear && (
+            <label className="block">
+              <span className="block text-xs font-medium text-gray-600 mb-1">Tahun ajaran kelas *</span>
+              <input
+                list="academic-years"
+                className={inputCls}
+                value={academicYear}
+                onChange={(e) => setAcademicYear(e.target.value)}
+                placeholder="mis. 2026/2027"
+              />
+              <datalist id="academic-years">
+                {academicYears.map((y) => (
+                  <option key={y} value={y} />
+                ))}
+              </datalist>
+              <span className="block text-xs text-gray-400 mt-1">
+                Kode kelas di file dicocokkan dengan kelas pada tahun ajaran ini, jadi kelas harus sudah ada.
+              </span>
+            </label>
+          )}
+
+          <div>
+            <input
+              ref={fileRef}
+              type="file"
+              accept=".xlsx,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
+              onChange={(e) => {
+                setFile(e.target.files?.[0] ?? null);
+                setError(null);
+              }}
+              className="block w-full text-sm text-gray-600 file:mr-3 file:px-3 file:py-2 file:rounded-lg file:border-0 file:bg-gray-100 file:text-gray-700 hover:file:bg-gray-200"
+            />
+          </div>
+
+          {error && (
+            <div className="text-sm text-red-700 bg-red-50 border border-red-100 rounded-lg px-4 py-3">
+              <p className="font-medium">{error.message}</p>
+              {error.rows.length > 0 && (
+                <ul className="mt-2 max-h-48 overflow-y-auto list-disc pl-5 space-y-1 text-xs">
+                  {error.rows.map((r, i) => (
+                    <li key={i}>{r}</li>
+                  ))}
+                </ul>
+              )}
+            </div>
+          )}
+        </div>
+      )}
+    </Modal>
+  );
+}
